   "source": [
    "### 5. Generate 10<sup>6</sup> samples from this joint density by rejection sampling, and confirm your sample statistics against the analytic values with standard errors. State your acceptance rate and explain how you chose the bounding constant."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 99,
   "id": "c5fe6631",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Empirical Acceptance Rate: 0.50001 (Theoretical: 0.50000)\n",
      "\n",
      "Statistic    | Sample Est.  | Std. Error   | Analytic    \n",
      "--------------------------------------------------------\n",
      "E[X]         | 0.583254     | 0.000276     | 0.583333    \n",
      "E[Y]         | 0.583221     | 0.000276     | 0.583333    \n",
      "E[XY]        | 0.333242     | 0.000236     | 0.333333    \n",
      "Var(X)       | 0.076362     | 0.000076     | 0.076389    \n",
      "Var(Y)       | 0.076363     | 0.000076     | 0.076389    \n",
      "Cov(X, Y)    | -0.006924    | 0.000075     | -0.006944   \n"
     ]
    }
   ],
   "source": [
    "N_target = n[6]\n",
    "M = 2.0\n",
    "\n",
    "# Generate samples in batches until we collect exactly 10^6 accepted pairs\n",
    "x_accepted = []\n",
    "y_accepted = []\n",
    "total_proposed = 0\n",
    "\n",
    "while sum(len(chunk) for chunk in x_accepted) < N_target:\n",
    "  batch_size = 500_000\n",
    "  x_cand = rng_1.uniform(0.0, 1.0, size=batch_size)\n",
    "  y_cand = rng_1.uniform(0.0, 1.0, size=batch_size)\n",
    "  u = rng_1.uniform(0.0, 1.0, size=batch_size)\n",
    "\n",
    "  # Acceptance condition: u <= f(x, y) / (M * g(x, y)) = (x + y) / 2\n",
    "  accept_mask = u <= (x_cand + y_cand) / M\n",
    "\n",
    "  x_accepted.append(x_cand[accept_mask])\n",
    "  y_accepted.append(y_cand[accept_mask])\n",
    "  total_proposed += batch_size\n",
    "\n",
    "# Trim to exact N_target = 10^6 samples (and adjust total_proposed proportionally)\n",
    "X = np.concatenate(x_accepted)[:N_target]\n",
    "Y = np.concatenate(y_accepted)[:N_target]\n",
    "total_accepted_all = sum(len(chunk) for chunk in x_accepted)\n",
    "empirical_acceptance_rate = total_accepted_all / total_proposed\n",
    "\n",
    "# --- Sample Statistics ---\n",
    "mean_X = np.mean(X)\n",
    "mean_Y = np.mean(Y)\n",
    "mean_XY = np.mean(X * Y)\n",
    "var_X = np.var(X, ddof=1)\n",
    "var_Y = np.var(Y, ddof=1)\n",
    "cov_XY = np.cov(X, Y, ddof=1)[0, 1]\n",
    "corr_XY = np.corrcoef(X, Y)[0, 1]\n",
    "\n",
    "# --- Standard Errors (SE) ---\n",
    "# SE of sample means: s / sqrt(N)\n",
    "se_mean_X = np.std(X, ddof=1) / np.sqrt(N_target)\n",
    "se_mean_Y = np.std(Y, ddof=1) / np.sqrt(N_target)\n",
    "se_mean_XY = np.std(X * Y, ddof=1) / np.sqrt(N_target)\n",
    "\n",
    "# SE of sample variance: sqrt(mu_4 - sigma^4) / sqrt(N)\n",
    "se_var_X = np.sqrt(np.mean((X - mean_X) ** 4) - var_X**2) / np.sqrt(N_target)\n",
    "se_var_Y = np.sqrt(np.mean((Y - mean_Y) ** 4) - var_Y**2) / np.sqrt(N_target)\n",
    "\n",
    "# SE of sample covariance: sqrt(E[(X - mu_X)^2 (Y - mu_Y)^2] - Cov^2) / sqrt(N)\n",
    "prod_dev = (X - mean_X) * (Y - mean_Y)\n",
    "se_cov_XY = np.sqrt(np.mean(prod_dev**2) - cov_XY**2) / np.sqrt(N_target)\n",
    "\n",
    "# SE of sample correlation: (1 - r^2) / sqrt(N - 2)\n",
    "se_corr_XY = (1 - corr_XY**2) / np.sqrt(N_target - 2)\n",
    "\n",
    "print(f\"Empirical Acceptance Rate: {empirical_acceptance_rate:.5f} (Theoretical: 0.50000)\\n\")\n",
    "print(f\"{'Statistic':<12} | {'Sample Est.':<12} | {'Std. Error':<12} | {'Analytic':<12}\")\n",
    "print(\"-\" * 56)\n",
    "print(f\"{'E[X]':<12} | {mean_X:<12.6f} | {se_mean_X:<12.6f} | {7/12:<12.6f}\")\n",
    "print(f\"{'E[Y]':<12} | {mean_Y:<12.6f} | {se_mean_Y:<12.6f} | {7/12:<12.6f}\")\n",
    "print(f\"{'E[XY]':<12} | {mean_XY:<12.6f} | {se_mean_XY:<12.6f} | {1/3:<12.6f}\")\n",
    "print(f\"{'Var(X)':<12} | {var_X:<12.6f} | {se_var_X:<12.6f} | {11/144:<12.6f}\")\n",
    "print(f\"{'Var(Y)':<12} | {var_Y:<12.6f} | {se_var_Y:<12.6f} | {11/144:<12.6f}\")\n",
    "print(f\"{'Cov(X, Y)':<12} | {cov_XY:<12.6f} | {se_cov_XY:<12.6f} | {-1/144:<12.6f}\")"
