    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy import stats\n",
    "from IPython.display import Markdown, display\n",
    "\n",
    "Sigma = np.array([[4.0, 2.0], [2.0, 4.0]])\n",
    "N = 10**6\n",
    "samples = rng_7.multivariate_normal([0, 0], Sigma, size=N)\n",
    "x, y = samples[:, 0], samples[:, 1]\n",
    "\n",
    "# Parts 3 and 4: bin by x, then get the mean and variance of y in each bin\n",
    "edges = np.linspace(-5, 5, 41)           # 40 bins, width 0.25\n",
    "bin_x, bin_mean, bin_var, se_mean, se_var = [], [], [], [], []\n",
    "\n",
    "for k in range(40):\n",
    "    in_bin = (x >= edges[k]) & (x < edges[k + 1])\n",
    "    n = in_bin.sum()\n",
    "    if n < 200:                           # skip bins with too few samples\n",
    "        continue\n",
    "    yb = y[in_bin]\n",
    "    v = yb.var(ddof=1)\n",
    "    bin_x.append(x[in_bin].mean())        # use the average x in the bin, not the bin center\n",
    "    bin_mean.append(yb.mean())\n",
    "    bin_var.append(v)\n",
    "    se_mean.append(np.sqrt(v / n))        # standard error of a mean\n",
    "    se_var.append(v * np.sqrt(2 / (n - 1)))   # standard error of a variance (Gaussian data)\n",
    "\n",
    "bin_x, bin_mean, bin_var = np.array(bin_x), np.array(bin_mean), np.array(bin_var)\n",
    "se_mean, se_var = np.array(se_mean), np.array(se_var)\n",
    "\n",
    "# slope of the binned means, plus a check using all the raw samples\n",
    "fit_bins = stats.linregress(bin_x, bin_mean)\n",
    "fit_raw = stats.linregress(x, y)\n",
    "z_slope = (fit_bins.slope - 0.5) / fit_bins.stderr\n",
    "\n",
    "print(f\"Binned slope = {fit_bins.slope:.4f} +/- {fit_bins.stderr:.4f}  (analytic 0.5, {abs(z_slope):.2f} SE away)\")\n",
    "print(f\"Raw slope    = {fit_raw.slope:.4f} +/- {fit_raw.stderr:.4f}\")\n",
    "print(f\"Bins used: {len(bin_x)}\")\n",
    "print(f\"Conditional variance: mean of bins = {bin_var.mean():.4f}, \"\n",
    "      f\"min = {bin_var.min():.3f}, max = {bin_var.max():.3f}  (analytic 3)\")\n",
    "\n",
    "# Figure 8\n",
    "xx = np.linspace(-5, 5, 100)\n",
    "fig, ax = plt.subplots(1, 2, figsize=(11, 4.2))\n",
    "\n",
    "ax[0].errorbar(bin_x, bin_mean, yerr=se_mean, fmt=\"o\", ms=4, capsize=2, label=\"binned mean of Y\")\n",
    "ax[0].plot(xx, 0.5 * xx, \"r-\", label=\"analytic 0.5x\")\n",
    "ax[0].set_xlabel(\"x\"); ax[0].set_ylabel(\"E[Y | X = x]\")\n",
    "ax[0].set_title(\"Figure 8a: conditional mean\"); ax[0].legend()\n",
    "\n",
    "ax[1].errorbar(bin_x, bin_var, yerr=se_var, fmt=\"o\", ms=4, capsize=2, label=\"binned variance of Y\")\n",
    "ax[1].axhline(3, color=\"r\", label=\"analytic 3\")\n",
    "ax[1].set_ylim(2.5, 3.5)\n",
    "ax[1].set_xlabel(\"x\"); ax[1].set_ylabel(\"Var(Y | X = x)\")\n",
    "ax[1].set_title(\"Figure 8b: conditional variance\"); ax[1].legend()\n",
    "plt.tight_layout(); plt.show()"
