    "EXY, _ = dblquad(lambda y, x: x * y * f_xy(y, x), 0, 1, 0, 1)\n",
    "EX2, _ = dblquad(lambda y, x: (x**2) * f_xy(y, x), 0, 1, 0, 1)\n",
